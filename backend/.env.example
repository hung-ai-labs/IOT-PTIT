# ─── Ứng dụng ────────────────────────────────────────────────
APP_NAME="Smart IoT — Monitoring & Control"
APP_VERSION=1.0.0
DEBUG=true

# ─── Cơ sở dữ liệu ───────────────────────────────────────────
# Khớp với infra/docker-compose.yml (cổng 5433 để không đụng PostgreSQL cài sẵn)
DATABASE_URL=postgresql+psycopg://iot:iot_password@localhost:5433/iot_db
# Bật để in toàn bộ câu lệnh SQL ra log (rất dài, chỉ dùng khi gỡ lỗi)
DB_ECHO=false

# ─── Bảo mật ─────────────────────────────────────────────────
# Sinh khoá mới: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=doi-khoa-nay-truoc-khi-trien-khai-that
ACCESS_TOKEN_EXPIRE_HOURS=8

# ─── MQTT ────────────────────────────────────────────────────
# Đặt false để chạy backend mà không kết nối MQTT (kiểm thử dùng cờ này)
ENABLE_MQTT=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Subscribe thêm bộ topic cũ (Sensor_data/Device_control/device_response)
# để tái hiện bài kiểm thử terminal ở SRS Chương 2 — xem docs/07 OQ-01
MQTT_LEGACY_TOPICS=true

# ─── Ngưỡng thời gian (giây) ─────────────────────────────────
COMMAND_TIMEOUT_SECONDS=5.0
DEVICE_OFFLINE_SECONDS=30
HEARTBEAT_SECONDS=10

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
