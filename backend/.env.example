# Spring Boot server
PORT=8000
# Local PostgreSQL from infra/docker-compose.yml
DB_URL=jdbc:postgresql://localhost:5433/iot_db
DB_USERNAME=iot
DB_PASSWORD=iot_password
# Existing Python DATABASE_URL is also supported if DB_URL is not set.
# Keep the existing key when migrating to retain unexpired JWTs.
SECRET_KEY=doi-khoa-nay-truoc-khi-trien-khai-that
ACCESS_TOKEN_EXPIRE_HOURS=8
ENABLE_MQTT=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_LEGACY_TOPICS=true
COMMAND_TIMEOUT_SECONDS=5
DEVICE_OFFLINE_SECONDS=30
HEARTBEAT_SECONDS=10
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
FRONTEND_DIR=../frontend
# Optional account-only seed command; no sensor/action samples.
SEED_PASSWORD=
